{
  "name": "draggable-scheduler",
  "version": "0.2.0",
  "description": "A React grid component for weekly resource scheduling with drag-and-drop, built on dnd-kit.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS Safari versions"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap && node scripts/build-style.mjs",
    "build:demo": "node scripts/build-standalone.mjs",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "react",
    "scheduler",
    "drag-and-drop",
    "dnd-kit",
    "timetable",
    "calendar",
    "resource-planning",
    "shift-planning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/c3nk/draggable-scheduler.git"
  },
  "author": "c3nk (https://c3nk.com)",
  "homepage": "https://github.com/c3nk/draggable-scheduler#readme"
}
